<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Gradient Background (#080B14 to #101827) -->
    <path
        android:pathData="M 0,0 L 320,0 L 320,180 L 0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#080B14"/>
                <item android:offset="0.5" android:color="#0E1422"/>
                <item android:offset="1.0" android:color="#101827"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Radial Glow in Left Orbit Area -->
    <path
        android:pathData="M 80,90 m -70,0 a 70,70 0 1,0 140,0 a 70,70 0 1,0 -140,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="80"
                android:startY="90"
                android:endX="150"
                android:endY="90"
                android:type="radial"
                android:gradientRadius="70">
                <item android:offset="0.0" android:color="#1A35D6F2"/>
                <item android:offset="0.6" android:color="#088768FF"/>
                <item android:offset="1.0" android:color="#00080B14"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
